    "tournament": "node scripts/tournament.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
