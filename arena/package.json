{
  "name": "arena-jogos-matematicos",
  "version": "1.0.0",
  "description": "Plataforma de jogos matemáticos (CNJM) com agentes de procura adversa, ranking ELO e jogo online",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
